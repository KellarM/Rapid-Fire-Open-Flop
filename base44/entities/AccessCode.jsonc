{
  "name": "AccessCode",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Who the code is for"
    },
    "code": {
      "type": "string",
      "description": "The entry code"
    },
    "expires": {
      "type": "string",
      "description": "Last day it works, date only, may be empty"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "False withdraws it without deleting it"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}