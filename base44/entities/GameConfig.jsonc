{
  "name": "GameConfig",
  "type": "object",
  "properties": {
    "anteStructureId": {
      "type": "string",
      "default": "C"
    },
    "cascadeEnabled": {
      "type": "boolean",
      "default": false
    },
    "rtpToolEnabled": {
      "type": "boolean",
      "default": false
    },
    "cardRtpTarget": {
      "type": "number",
      "default": 96.5
    },
    "rankRtpTarget": {
      "type": "number",
      "default": 96.5
    }
  },
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}